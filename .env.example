# Copy to .env and fill in your course key. Never commit .env.
# OpenAI() reads these two straight from the environment.
OPENAI_BASE_URL=https://llm.nat-d.uk/v1
OPENAI_API_KEY=sk-replace-me

# Models exposed by the class proxy.
CHAT_MODEL=gemma-4-E4B-it
EMBED_MODEL=bge-m3

# Retrieval knobs (defaults in app/config.py; eval/eval_retrieval.py compares alternatives).
# RETRIEVER=hybrid
# CHUNK_WORDS=120
# CHUNK_OVERLAP=30
# TOP_K=5
# MIN_SCORE=0.45
